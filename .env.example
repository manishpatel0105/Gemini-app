# SAARTHI AI Environment Configuration
# Copy this file to .env to configure local environment variables.

# Google Gemini API Key (Required for Live Gemini 2.5 Flash mode)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 3000)
PORT=3000

# Server Host (Default: 0.0.0.0)
HOST=0.0.0.0

# Optional: Default analysis mode ('live' or 'demo')
DEFAULT_MODE=live
